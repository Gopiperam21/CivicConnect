PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/citysync?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret

# Optional first city-staff account (never put these values in source control)
STAFF_NAME=City Staff
STAFF_EMAIL=
STAFF_PASSWORD=
STAFF_DEPARTMENT=Municipal
STAFF_CITY=Guntur

# Optional email updates
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional SMS via Twilio; SMS phone is collected only with resident consent
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

